# ============================================================
#  .gitignore —— 仓库的「门口安检黑名单」
#  规则：这个文件里写到的名字 / 通配符，
#        git add 会自动跳过 → 永远进不了 GitHub
#  更新日期：2026-09-17（Day 2）
#  适用项目：Vibe Coding 学习项目（大学生日程规划 / 英语综合学习）
# ============================================================


# ------------------------------------------------------------
# 一、环境变量与密钥 —— 【最高优先级，绝对不能上传】
# ------------------------------------------------------------
# .env 是本地配置文件，以后（Day 23）会往里放数据库密码、API 密钥
.env
.env.local
.env.development

# 其他常见命名变体
.env.*.local
.env.production.local
*.env.local

# 各种密钥 / 证书文件（有了就别传，传了等于把家门钥匙挂网上）
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# 存放密钥的 JSON 配置文件
secrets.json
secrets.*.json
credentials.json
credentials.*.json
service-account*.json

# 本地配置覆盖文件（含个人路径、个人 token 等）
config.local.json
config.local.js
*.local.config.*


# ------------------------------------------------------------
# 二、依赖目录 —— 【体积巨大，别人用 npm install 自己装】
# ------------------------------------------------------------
node_modules/
vendor/
bower_components/

# Python 虚拟环境（以后可能用 Python 脚本辅助）
.venv/
venv/
env/
__pycache__/
*.py[cod]

# 打包产物（每次构建都能重新生成，没必要进版本库）
dist/
build/
out/
.next/
.nuxt/
.cache/


# ------------------------------------------------------------
# 三、本地数据库文件 —— 【体积大 + 含个人数据，绝对不能上传】
# ------------------------------------------------------------
# SQLite（最可能用到：大学生日程规划的本地存储）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal

# Access
*.mdb
*.accdb

# 数据库导出文件（SQL 转储 / 备份）
*.sql
*.dump
*.bak
*.backup

# 注：如果你以后想「故意」提交建表脚本（比如 schema.sql），
#      可以用 git add -f schema.sql 强制加入，不受本规则限制。


# ------------------------------------------------------------
# 四、系统临时文件 —— 【你的电脑专属，别人电脑里没意义】
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory


# ------------------------------------------------------------
# 五、编辑器 / IDE 配置 —— 【个人偏好，不该污染别人】
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-workspace
*.sublime-project


# ------------------------------------------------------------
# 六、日志与调试产物
# ------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.coverage/
coverage/
.nyc_output/


# ------------------------------------------------------------
# 七、本机专用工具目录 —— 【只在你电脑上用，不进仓库】
# ------------------------------------------------------------
_tools_local/
